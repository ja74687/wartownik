<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Wartownik.ViewModels"
        xmlns:globalization="using:System.Globalization"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="560"
        x:Class="Wartownik.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Localization[App.Title]}"
        Width="800" Height="560"
        MinWidth="560" MinHeight="400"
        Background="Transparent"
        TransparencyLevelHint="Mica,AcrylicBlur,Blur,None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Grid RowDefinitions="32,*">

        <!-- Custom title bar (drag area) -->
        <Border Grid.Row="0"
                Name="TitleBar"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped" />

        <!-- ============================================================ -->
        <!-- View 1: profile list (visible when not in details)            -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1"
              Margin="36,8,36,28"
              RowDefinitions="Auto,Auto,Auto,*"
              IsVisible="{Binding !IsViewingDetails}">

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,16,0,0">
                <TextBlock DockPanel.Dock="Left"
                           Classes="h1"
                           Text="{Binding Localization[App.Title]}" />
                <ComboBox DockPanel.Dock="Right"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}"
                          Width="160"
                          VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="globalization:CultureInfo">
                            <TextBlock Text="{Binding NativeName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,32,0,12">
                <TextBlock DockPanel.Dock="Left"
                           Classes="h2"
                           VerticalAlignment="Center"
                           Text="{Binding Localization[Profiles.Title]}" />
                <Button DockPanel.Dock="Right"
                        Classes="accent"
                        Padding="16,8"
                        Content="{Binding Localization[Profiles.AddNew]}"
                        Command="{Binding AddProfileCommand}" />
            </DockPanel>

            <Border Grid.Row="2"
                    Classes="card"
                    Padding="20,32"
                    IsVisible="{Binding !HasProfiles}">
                <TextBlock Classes="subtle"
                           HorizontalAlignment="Center"
                           Text="{Binding Localization[Profiles.NoneYet]}" />
            </Border>

            <ListBox Grid.Row="3"
                     Classes="cards"
                     ItemsSource="{Binding Profiles}"
                     IsVisible="{Binding HasProfiles}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:ConnectionProfileItemViewModel">
                        <Button Classes="card-button"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileCommand}"
                                CommandParameter="{Binding}">
                            <Border Classes="card">
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Classes="h3" Text="{Binding DisplayName}" />
                                        <TextBlock Classes="caption" Text="{Binding Endpoint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                        <Button Classes="icon edit"
                                                Content="&#x270E;"
                                                ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localization[Profiles.Edit]}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditProfileCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Classes="icon danger"
                                                Content="&#x2715;"
                                                ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localization[Profiles.Delete]}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteProfileCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- ============================================================ -->
        <!-- View 2: profile details (visible when IsViewingDetails)       -->
        <!-- ============================================================ -->
        <ContentControl Grid.Row="1"
                        IsVisible="{Binding IsViewingDetails}"
                        Content="{Binding Details}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="vm:ProfileDetailsViewModel">
                    <Grid Margin="36,8,36,28" RowDefinitions="Auto,Auto,Auto,*">

                        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,16,0,0">
                            <Button DockPanel.Dock="Left"
                                    Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localization[Common.Back]}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BackToProfilesCommand}"
                                    Padding="16,8"
                                    VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel Grid.Row="1" Spacing="2" Margin="0,20,0,0">
                            <TextBlock Classes="h1" Text="{Binding Profile.DisplayName}" />
                            <TextBlock Classes="subtle" Text="{Binding Endpoint}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Classes="h2"
                                   Text="{Binding Localization[Databases.Title]}"
                                   Margin="0,28,0,12" />

                        <Grid Grid.Row="3">
                            <Border Classes="card"
                                    Padding="20,32"
                                    IsVisible="{Binding IsLoading}">
                                <TextBlock Classes="subtle"
                                           HorizontalAlignment="Center"
                                           Text="{Binding Localization[Common.Loading]}" />
                            </Border>

                            <Border Padding="12,10"
                                    CornerRadius="6"
                                    Background="#1AE53935"
                                    BorderBrush="#88E53935"
                                    BorderThickness="1"
                                    VerticalAlignment="Top"
                                    IsVisible="{Binding HasError}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Localization[Databases.LoadFailed]}"
                                               Foreground="#FFE53935"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="#FFE53935"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Classes="card"
                                    Padding="20,32"
                                    IsVisible="{Binding IsEmpty}">
                                <TextBlock Classes="subtle"
                                           HorizontalAlignment="Center"
                                           Text="{Binding Localization[Databases.Empty]}" />
                            </Border>

                            <ListBox Classes="cards"
                                     ItemsSource="{Binding Databases}"
                                     IsVisible="{Binding HasDatabases}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="vm:DatabaseItemViewModel">
                                        <Border Classes="card">
                                            <TextBlock Classes="h3" Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</Window>
