<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Wartownik.ViewModels"
        xmlns:globalization="using:System.Globalization"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
        x:Class="Wartownik.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Localization[App.Title]}"
        Icon="/Assets/wartownik.ico"
        Width="1100" Height="680"
        MinWidth="780" MinHeight="500"
        Background="#0F172A"
        TransparencyLevelHint="None"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        CanResize="True">

    <Grid RowDefinitions="32,Auto,*" DragDrop.AllowDrop="True">

        <!-- Custom title bar with our own caption buttons. -->
        <Grid Grid.Row="0" Background="#0F172A" ColumnDefinitions="*,Auto">
            <Border Grid.Column="0"
                    Background="#0F172A"
                    PointerPressed="OnTitleBarPointerPressed"
                    DoubleTapped="OnTitleBarDoubleTapped" />
            <StackPanel Grid.Column="1" Background="#0F172A" Orientation="Horizontal">
                <Button Classes="caption"
                        Content="&#xE921;"
                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                        ToolTip.Tip="Minimize"
                        Click="OnMinimizeClick" />
                <Button Classes="caption"
                        Content="&#xE922;"
                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                        ToolTip.Tip="Maximize"
                        Click="OnMaximizeClick" />
                <Button Classes="caption close"
                        Content="&#xE8BB;"
                        FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                        ToolTip.Tip="Close"
                        Click="OnCloseClick" />
            </StackPanel>
        </Grid>

        <!-- Update banner — appears between title bar and content when a newer version is on
             GitHub Releases. IsApplyingUpdate disables the buttons while the download/restart
             cycle runs. -->
        <Border Grid.Row="1"
                Padding="20,10"
                Background="#1A1F2E"
                BorderBrush="#3B82F6"
                BorderThickness="0,0,0,1"
                IsVisible="{Binding HasAvailableUpdate}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0"
                           Text="&#xE777;"
                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                           Foreground="#3B82F6"
                           FontSize="16"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold"
                               Foreground="#F3F4F6"
                               Text="{Binding AvailableUpdateText}" />
                    <TextBlock Classes="caption"
                               Text="Install now to download and restart with the new version." />
                </StackPanel>
                <Button Grid.Column="2"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Content="Later"
                        Command="{Binding DismissUpdateCommand}" />
                <Button Grid.Column="3"
                        Padding="14,6"
                        Classes="accent"
                        Content="Install now"
                        Command="{Binding InstallUpdateCommand}" />
            </Grid>
        </Border>

        <!-- Sidebar + content -->
        <Grid Grid.Row="2" ColumnDefinitions="240,*">

            <!-- ============================================================ -->
            <!-- Sidebar — hierarchical breadcrumb routing                     -->
            <!-- ============================================================ -->
            <Border Grid.Column="0" Classes="sidebar">
                <Grid Margin="16,12,16,16" RowDefinitions="Auto,Auto,*,Auto">

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="10"
                                Margin="6,8,0,18"
                                VerticalAlignment="Center">
                        <Image Width="28" Height="28"
                               Source="/Assets/wartownik.png"
                               VerticalAlignment="Center" />
                        <TextBlock Classes="h2"
                                   Text="{Binding Localization[App.Title]}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="2">
                        <TextBlock Classes="eyebrow"
                                   Text="Navigation"
                                   Margin="6,0,0,8" />

                        <!-- Level 1: Connection profiles (always visible) -->
                        <Button Classes="nav"
                                Classes.active="{Binding ShowProfileList}"
                                Content="{Binding Localization[Profiles.Title]}"
                                Command="{Binding BackToProfilesCommand}" />

                        <!-- Level 2: profile name (visible when viewing details) -->
                        <Button Classes="nav"
                                Margin="14,0,0,0"
                                Classes.active="{Binding IsProfileLevelActive}"
                                Content="{Binding Details.Profile.DisplayName, FallbackValue=''}"
                                Command="{Binding Details.BackToDatabasesCommand}"
                                IsVisible="{Binding IsViewingDetails}" />

                        <!-- Level 3: database name (visible when in database workspace) -->
                        <Button Classes="nav"
                                Margin="28,0,0,0"
                                Classes.active="{Binding IsDatabaseLevelActive}"
                                Content="{Binding Details.SelectedDatabase.DatabaseName, FallbackValue=''}"
                                IsVisible="{Binding IsAtDatabaseLevel}" />

                        <!-- Pending changes hint — appears under the database breadcrumb when the
                             user has staged edits in the Permissions matrix. Same warn palette
                             as the sticky bar so it reads as "you have something to apply". -->
                        <Border Margin="34,4,0,0"
                                Padding="8,3"
                                CornerRadius="999"
                                Background="#1AF59E0B"
                                BorderBrush="#88F59E0B"
                                BorderThickness="1"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding Details.SelectedDatabase.HasPendingChanges, FallbackValue=False}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" Fill="#F59E0B" VerticalAlignment="Center" />
                                <TextBlock Foreground="#F59E0B"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="{Binding Details.SelectedDatabase.PendingCount, StringFormat='{}{0} pending changes'}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Spacer (Row 2: *) -->

                    <Button Grid.Row="3"
                            Classes="nav"
                            HorizontalAlignment="Stretch"
                            Classes.active="{Binding IsViewingSettings}"
                            Content="{Binding Localization[Settings.Nav]}"
                            Command="{Binding OpenSettingsCommand}" />
                </Grid>
            </Border>

            <!-- ============================================================ -->
            <!-- Content area                                                  -->
            <!-- ============================================================ -->
            <Grid Grid.Column="1">

                <!-- View 1: profile list -->
                <Grid Margin="36,16,36,16"
                      RowDefinitions="Auto,Auto,Auto,*,Auto"
                      IsVisible="{Binding ShowProfileList}">

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Spacing="3">
                            <TextBlock Classes="eyebrow"
                                       Text="{Binding Localization[App.Title]}" />
                            <TextBlock Classes="h1"
                                       Text="{Binding Localization[Profiles.Title]}" />
                            <TextBlock Classes="caption"
                                       Text="{Binding ProfilesCountLabel}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Classes="accent"
                                Padding="18,9"
                                VerticalAlignment="Center"
                                Content="{Binding Localization[Profiles.AddNew]}"
                                Command="{Binding AddProfileCommand}" />
                    </DockPanel>

                    <TextBox Grid.Row="1"
                             Classes="search"
                             Margin="0,16,0,0"
                             PlaceholderText="{Binding Localization[Profiles.SearchPlaceholder]}"
                             Text="{Binding SearchFilter}" />

                    <Border Grid.Row="2"
                            Classes="card"
                            Padding="20,32"
                            Margin="0,16,0,0"
                            IsVisible="{Binding !HasProfiles}">
                        <TextBlock Classes="subtle"
                                   HorizontalAlignment="Center"
                                   Text="{Binding Localization[Profiles.NoneYet]}" />
                    </Border>

                    <ListBox Grid.Row="3"
                             Classes="cards"
                             Margin="0,16,0,0"
                             ItemsSource="{Binding Profiles}"
                             IsVisible="{Binding HasProfiles}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ConnectionProfileItemViewModel">
                                <Button Classes="card-button"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenProfileCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="card">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                            <!-- Avatar with subtle gradient (brush built in VM) -->
                                            <Border Grid.Column="0"
                                                    Classes="avatar"
                                                    Background="{Binding AvatarBrush}">
                                                <TextBlock Text="{Binding Initials}" />
                                            </Border>

                                            <!-- Name + endpoint + status -->
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3">
                                                <TextBlock Classes="h3"
                                                           Foreground="#F3F4F6"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Classes="caption"
                                                           Foreground="#94A3B8"
                                                           Text="{Binding Endpoint}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                                    <Border Classes="pill success" IsVisible="{Binding IsConnected}">
                                                        <TextBlock Text="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Localization[Status.Connected]}" />
                                                    </Border>
                                                    <Border Classes="pill danger" IsVisible="{Binding IsDisconnected}">
                                                        <TextBlock Text="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Localization[Status.Disconnected]}" />
                                                    </Border>
                                                    <Border Classes="pill" IsVisible="{Binding IsChecking}">
                                                        <TextBlock Text="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Localization[Status.Checking]}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Counter + inline actions -->
                                            <StackPanel Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Spacing="6">
                                                <TextBlock Classes="caption"
                                                           Foreground="#94A3B8"
                                                           HorizontalAlignment="Right"
                                                           Text="{Binding CountersText}"
                                                           IsVisible="{Binding HasCounters}" />
                                                <TextBlock Classes="caption"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Right"
                                                           FontSize="11"
                                                           Text="{Binding LastEditedText}"
                                                           IsVisible="{Binding HasLastEdited}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                                    <Button Classes="icon"
                                                            Content="&#x21E9;"
                                                            Foreground="#94A3B8"
                                                            ToolTip.Tip="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Localization[Profiles.Export]}"
                                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ExportProfileCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="icon edit"
                                                            Content="&#x270E;"
                                                            Foreground="#94A3B8"
                                                            ToolTip.Tip="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Localization[Profiles.Edit]}"
                                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).EditProfileCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Classes="icon danger"
                                                            Content="&#x2715;"
                                                            Foreground="#94A3B8"
                                                            ToolTip.Tip="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).Localization[Profiles.Delete]}"
                                                            Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteProfileCommand}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Chevron -->
                                            <TextBlock Grid.Column="3"
                                                       Text="&#x276F;"
                                                       Margin="14,0,0,0"
                                                       FontSize="14"
                                                       Foreground="#64748B"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Margin="0,16,0,0" HorizontalAlignment="Center">
                        <!-- Import result replaces the tip when there's something to say. -->
                        <TextBlock Classes="caption"
                                   HorizontalAlignment="Center"
                                   Foreground="#10B981"
                                   TextWrapping="Wrap"
                                   Text="{Binding StatusMessage}"
                                   IsVisible="{Binding HasStatus}" />
                        <TextBlock Classes="caption"
                                   HorizontalAlignment="Center"
                                   Text="{Binding Localization[Profiles.TipImport]}"
                                   IsVisible="{Binding !HasStatus}" />
                    </StackPanel>
                </Grid>

                <!-- View 2: profile details -->
                <ContentControl IsVisible="{Binding ShowProfileDetails}"
                                Content="{Binding Details}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate DataType="vm:ProfileDetailsViewModel">
                            <Grid>

                                <!-- ============================================ -->
                                <!-- Profile workspace (DBs + Roles)               -->
                                <!-- ============================================ -->
                                <Grid Margin="36,16,36,28"
                                      RowDefinitions="Auto,*"
                                      IsVisible="{Binding !IsViewingDatabase}">

                                <StackPanel Grid.Row="0" Spacing="3">
                                    <TextBlock Classes="eyebrow"
                                               Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Localization[Profiles.Title]}" />
                                    <TextBlock Classes="h1" Text="{Binding Profile.DisplayName}" />
                                    <TextBlock Classes="subtle" Text="{Binding Endpoint}" />
                                </StackPanel>

                                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="0,24,0,0">

                                    <Border Grid.Row="0"
                                            Classes="card"
                                            Padding="20,32"
                                            IsVisible="{Binding IsLoading}">
                                        <TextBlock Classes="subtle"
                                                   HorizontalAlignment="Center"
                                                   Text="{Binding Localization[Common.Loading]}" />
                                    </Border>

                                    <Border Grid.Row="1"
                                            Padding="14,12"
                                            Margin="0,0,0,16"
                                            CornerRadius="8"
                                            Background="#1AE53935"
                                            BorderBrush="#88E53935"
                                            BorderThickness="1"
                                            IsVisible="{Binding HasError}">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Localization[Databases.LoadFailed]}"
                                                       Foreground="#FFE53935"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       Foreground="#FFE53935"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <TabControl Grid.Row="2" IsVisible="{Binding IsContentVisible}">

                                        <!-- ============ Databases tab ============ -->
                                        <TabItem>
                                            <TabItem.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Localization[Databases.Title]}"
                                                               VerticalAlignment="Center" />
                                                    <Border Classes="badge">
                                                        <TextBlock Text="{Binding Databases.Count}" />
                                                    </Border>
                                                </StackPanel>
                                            </TabItem.Header>

                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                                                <StackPanel Spacing="12">
                                                    <Border Classes="card"
                                                            Padding="20,28"
                                                            IsVisible="{Binding IsDatabasesEmpty}">
                                                        <TextBlock Classes="subtle"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding Localization[Databases.Empty]}" />
                                                    </Border>

                                                    <ItemsControl ItemsSource="{Binding Databases}"
                                                                  IsVisible="{Binding HasDatabases}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:DatabaseItemViewModel">
                                                                <Button Classes="card-button"
                                                                        Margin="0,0,0,10"
                                                                        Command="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).OpenDatabaseCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Border Classes="card" Padding="20,16">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                                            <!-- Database icon -->
                                                                            <Border Grid.Column="0"
                                                                                    Width="44" Height="44"
                                                                                    CornerRadius="8"
                                                                                    Background="#1E293B"
                                                                                    BorderBrush="#334155"
                                                                                    BorderThickness="1"
                                                                                    Margin="0,0,16,0"
                                                                                    VerticalAlignment="Center">
                                                                                <TextBlock Text="&#xE968;"
                                                                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                                                           FontSize="20"
                                                                                           Foreground="#94A3B8"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Border>

                                                                            <!-- Name + metadata + pills -->
                                                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                                                <TextBlock Classes="h3" Text="{Binding Name}" />
                                                                                <TextBlock Classes="subtle"
                                                                                           Text="{Binding MetadataLine}"
                                                                                           IsVisible="{Binding MetadataLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                                <ItemsControl>
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <WrapPanel Orientation="Horizontal" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <Border Classes="pill"
                                                                                            Margin="0,0,6,0"
                                                                                            IsVisible="{Binding HasSchemaCount}">
                                                                                        <TextBlock Text="{Binding SchemaCountText}" />
                                                                                    </Border>
                                                                                    <Border Classes="pill"
                                                                                            Margin="0,0,6,0"
                                                                                            IsVisible="{Binding HasUserCount}">
                                                                                        <TextBlock Text="{Binding UserCountText}" />
                                                                                    </Border>
                                                                                    <Border Classes="pill"
                                                                                            Margin="0,0,6,0"
                                                                                            IsVisible="{Binding HasGrantCount}">
                                                                                        <TextBlock Text="{Binding GrantCountText}" />
                                                                                    </Border>
                                                                                    <Border Classes="pill warn"
                                                                                            Margin="0,0,6,0"
                                                                                            IsVisible="{Binding HasPendingCount}">
                                                                                        <TextBlock Text="{Binding PendingCountText}" />
                                                                                    </Border>
                                                                                </ItemsControl>
                                                                            </StackPanel>

                                                                            <!-- Last sync + chevron -->
                                                                            <StackPanel Grid.Column="2"
                                                                                        Orientation="Horizontal"
                                                                                        Spacing="12"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Classes="caption"
                                                                                           Text="{Binding LastSyncText}"
                                                                                           VerticalAlignment="Center"
                                                                                           IsVisible="{Binding HasLastSync}" />
                                                                                <TextBlock Text="&#x276F;"
                                                                                           FontSize="14"
                                                                                           Opacity="0.5"
                                                                                           VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Dashed "Add a database" placeholder card (Iter 3 visual; wiring later) -->
                                                    <Border Classes="card add-card"
                                                            Padding="20,18"
                                                            Margin="0,8,0,32"
                                                            IsVisible="{Binding HasDatabases}">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    Spacing="10">
                                                            <TextBlock Text="+"
                                                                       FontSize="18"
                                                                       Foreground="#94A3B8"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Classes="subtle"
                                                                       Text="{Binding Localization[Databases.AddNew]}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>

                                        <!-- ============ Users tab (login roles) ============ -->
                                        <TabItem>
                                            <TabItem.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Localization[Users.Title]}"
                                                               VerticalAlignment="Center" />
                                                    <Border Classes="badge">
                                                        <TextBlock Text="{Binding Users.Count}" />
                                                    </Border>
                                                </StackPanel>
                                            </TabItem.Header>

                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                                                <StackPanel Spacing="12">
                                                    <DockPanel LastChildFill="False">
                                                        <Button DockPanel.Dock="Right"
                                                                Classes="accent"
                                                                Padding="14,6"
                                                                Content="{Binding Localization[Users.AddNew]}"
                                                                Command="{Binding AddUserCommand}" />
                                                    </DockPanel>

                                                    <Border Classes="card"
                                                            Padding="20,28"
                                                            IsVisible="{Binding IsUsersEmpty}">
                                                        <TextBlock Classes="subtle"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding Localization[Users.Empty]}" />
                                                    </Border>

                                                    <!-- Margin bottom on the list itself: Avalonia ScrollViewer Padding doesn't
                                                         expand scroll extent, so the only way to leave breathing room under the
                                                         last card is to add Margin to the content. -->
                                                    <ItemsControl ItemsSource="{Binding Users}"
                                                                  IsVisible="{Binding HasUsers}"
                                                                  Margin="0,0,0,32">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:RoleItemViewModel">
                                                                <Border Classes="card" Margin="0,0,0,10">
                                                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                        <StackPanel Grid.Column="0" Spacing="6">
                                                                            <TextBlock Classes="h3" Text="{Binding Name}" />
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <Border Classes="pill warn"
                                                                                        IsVisible="{Binding IsSuperuser}">
                                                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Roles.Superuser]}" />
                                                                                </Border>
                                                                                <Border Classes="pill accent">
                                                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Roles.CanLogin]}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Classes="caption"
                                                                                       TextWrapping="Wrap"
                                                                                       IsVisible="{Binding HasMemberships}"
                                                                                       Text="{Binding MemberOfLabel}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                            <Button Classes="icon"
                                                                                    Content="&#x1F465;"
                                                                                    IsVisible="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).CanEditMembership}"
                                                                                    ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Membership.Action]}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).EditMembershipCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Classes="icon edit"
                                                                                    Content="&#x270E;"
                                                                                    ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Roles.Edit]}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).EditRoleCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Classes="icon danger"
                                                                                    Content="&#x2715;"
                                                                                    ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Roles.Drop]}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).DropRoleCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>

                                        <!-- ============ Roles tab (groups, no-login) ============ -->
                                        <TabItem>
                                            <TabItem.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Localization[Roles.Title]}"
                                                               VerticalAlignment="Center" />
                                                    <Border Classes="badge">
                                                        <TextBlock Text="{Binding Roles.Count}" />
                                                    </Border>
                                                </StackPanel>
                                            </TabItem.Header>

                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,16,12,0">
                                                <StackPanel Spacing="12">
                                                    <DockPanel LastChildFill="False">
                                                        <Button DockPanel.Dock="Right"
                                                                Classes="accent"
                                                                Padding="14,6"
                                                                Content="{Binding Localization[Roles.AddNew]}"
                                                                Command="{Binding AddRoleCommand}" />
                                                    </DockPanel>

                                                    <Border Classes="card"
                                                            Padding="20,28"
                                                            IsVisible="{Binding IsRolesEmpty}">
                                                        <TextBlock Classes="subtle"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding Localization[Roles.Empty]}" />
                                                    </Border>

                                                    <ItemsControl ItemsSource="{Binding Roles}"
                                                                  IsVisible="{Binding HasRoles}"
                                                                  Margin="0,0,0,32">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:RoleItemViewModel">
                                                                <Border Classes="card" Margin="0,0,0,10">
                                                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                        <StackPanel Grid.Column="0" Spacing="6">
                                                                            <TextBlock Classes="h3" Text="{Binding Name}" />
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <Border Classes="pill warn"
                                                                                        IsVisible="{Binding IsSuperuser}">
                                                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Roles.Superuser]}" />
                                                                                </Border>
                                                                                <Border Classes="pill">
                                                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Roles.NoLogin]}" />
                                                                                </Border>
                                                                            </StackPanel>
                                                                            <TextBlock Classes="caption"
                                                                                       TextWrapping="Wrap"
                                                                                       IsVisible="{Binding HasMemberships}"
                                                                                       Text="{Binding MemberOfLabel}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                            <Button Classes="icon"
                                                                                    Content="&#x1F465;"
                                                                                    IsVisible="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).CanEditMembership}"
                                                                                    ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Membership.Action]}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).EditMembershipCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Classes="icon edit"
                                                                                    Content="&#x270E;"
                                                                                    ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Roles.Edit]}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).EditRoleCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                            <Button Classes="icon danger"
                                                                                    Content="&#x2715;"
                                                                                    ToolTip.Tip="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).Localization[Roles.Drop]}"
                                                                                    Command="{Binding $parent[ItemsControl].((vm:ProfileDetailsViewModel)DataContext).DropRoleCommand}"
                                                                                    CommandParameter="{Binding}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                                </Grid>

                                <!-- ============================================ -->
                                <!-- Database workspace                            -->
                                <!-- ============================================ -->
                                <ContentControl IsVisible="{Binding IsViewingDatabase}"
                                                Content="{Binding SelectedDatabase}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate DataType="vm:DatabaseDetailsViewModel">
                                            <Grid Margin="36,16,36,16" RowDefinitions="Auto,Auto,*">

                                                <!-- Header: eyebrow profile name + h1 db name + metadata subtitle. Right side: Test connection. -->
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <TextBlock Classes="eyebrow"
                                                                   Text="{Binding Profile.DisplayName}" />
                                                        <TextBlock Classes="h1" Text="{Binding DatabaseName}" />
                                                        <TextBlock Classes="subtle"
                                                                   Text="{Binding MetadataLine}"
                                                                   IsVisible="{Binding MetadataLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                Spacing="8"
                                                                VerticalAlignment="Top">
                                                        <Button Padding="14,8"
                                                                Command="{Binding ExportYamlCommand}"
                                                                Content="{Binding Localization[Common.ExportYaml]}" />
                                                        <Button Padding="14,8"
                                                                Command="{Binding TestConnectionCommand}"
                                                                IsEnabled="{Binding !TestInProgress}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="&#xE721;"
                                                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Localization[Common.Test]}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Test status line under header (visible after Test connection click). -->
                                                <TextBlock Grid.Row="1"
                                                           Classes="caption"
                                                           Margin="0,8,0,0"
                                                           Text="{Binding TestStatus}"
                                                           IsVisible="{Binding HasTestStatus}" />

                                                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">

                                                    <Border Grid.Row="0"
                                                            Classes="card"
                                                            Padding="20,32"
                                                            IsVisible="{Binding IsLoading}">
                                                        <TextBlock Classes="subtle"
                                                                   HorizontalAlignment="Center"
                                                                   Text="{Binding Localization[Common.Loading]}" />
                                                    </Border>

                                                    <Border Grid.Row="1"
                                                            Padding="14,12"
                                                            Margin="0,0,0,16"
                                                            CornerRadius="8"
                                                            Background="#1AE53935"
                                                            BorderBrush="#88E53935"
                                                            BorderThickness="1"
                                                            IsVisible="{Binding HasError}">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding Localization[Schemas.LoadFailed]}"
                                                                       Foreground="#FFE53935"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ErrorMessage}"
                                                                       Foreground="#FFE53935"
                                                                       TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>

                                                    <TabControl Grid.Row="2"
                                                                IsVisible="{Binding IsContentVisible}"
                                                                SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                                                        <!-- ============ Overview tab ============ -->
                                                        <TabItem Header="{Binding Localization[DatabaseTabs.Overview]}">
                                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          Padding="0,16,12,0">
                                                                <StackPanel Spacing="24">

                                                                    <!-- CONNECTION + AT A GLANCE row.
                                                                         CONNECTION shows how Wartownik is talking to this DB right now (login user from profile + DB owner).
                                                                         AT A GLANCE shows live counts. -->
                                                                    <Grid ColumnDefinitions="*,24,Auto">

                                                                        <StackPanel Grid.Column="0" Spacing="6">
                                                                            <TextBlock Classes="eyebrow"
                                                                                       Text="{Binding Localization[Overview.ConnectionSection]}" />
                                                                            <TextBlock Classes="h2"
                                                                                       Text="{Binding Localization[Overview.ConnectionHeading]}" />
                                                                            <Border Classes="card" Padding="20,16" Margin="0,8,0,0">
                                                                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                                                    <Border Grid.Column="0"
                                                                                            Width="44" Height="44"
                                                                                            CornerRadius="999"
                                                                                            Background="#3B82F6"
                                                                                            Margin="0,0,16,0"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding UserInitial}"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="White" />
                                                                                    </Border>
                                                                                    <StackPanel Grid.Column="1" Spacing="6">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                            <TextBlock Classes="h3" Text="{Binding Profile.Username}" />
                                                                                            <Border Classes="pill accent" VerticalAlignment="Center">
                                                                                                <TextBlock Text="{Binding Localization[Overview.PillLogin]}" />
                                                                                            </Border>
                                                                                            <Border Classes="pill warn" VerticalAlignment="Center"
                                                                                                    IsVisible="{Binding IsConnectingAsOwner}">
                                                                                                <TextBlock Text="{Binding Localization[Overview.PillOwner]}" />
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                        <TextBlock Classes="subtle"
                                                                                                   Text="{Binding Endpoint}" />
                                                                                        <TextBlock Classes="caption"
                                                                                                   Text="{Binding OwnerLine}"
                                                                                                   IsVisible="{Binding OwnerLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <StackPanel Grid.Column="2" Spacing="6" MinWidth="280">
                                                                            <TextBlock Classes="eyebrow"
                                                                                       Text="{Binding Localization[Overview.AtAGlance]}" />
                                                                            <TextBlock Classes="h2" Opacity="0">
                                                                                <!-- Spacer to align card with the connection card on the left -->
                                                                                <Run Text="·" />
                                                                            </TextBlock>
                                                                            <Border Classes="card" Padding="20,16" Margin="0,8,0,0">
                                                                                <Grid ColumnDefinitions="*,*,*"
                                                                                      RowDefinitions="Auto,12,Auto"
                                                                                      VerticalAlignment="Center">

                                                                                    <!-- Top row — scale stats: schemas / grants / users -->
                                                                                    <StackPanel Grid.Row="0" Grid.Column="0"
                                                                                                HorizontalAlignment="Center"
                                                                                                ToolTip.Tip="{Binding Localization[Overview.SchemasTooltip]}">
                                                                                        <TextBlock Text="{Binding SchemaCountText}"
                                                                                                   FontSize="22"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="#F3F4F6"
                                                                                                   HorizontalAlignment="Center" />
                                                                                        <TextBlock Classes="caption"
                                                                                                   Text="{Binding Localization[Schemas.Title]}"
                                                                                                   HorizontalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Row="0" Grid.Column="1"
                                                                                                HorizontalAlignment="Center"
                                                                                                ToolTip.Tip="{Binding Localization[Overview.GrantsTooltip]}">
                                                                                        <TextBlock Text="{Binding GrantCountText}"
                                                                                                   FontSize="22"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="#F3F4F6"
                                                                                                   HorizontalAlignment="Center" />
                                                                                        <TextBlock Classes="caption"
                                                                                                   Text="{Binding Localization[Overview.Grants]}"
                                                                                                   HorizontalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Row="0" Grid.Column="2"
                                                                                                HorizontalAlignment="Center"
                                                                                                ToolTip.Tip="{Binding Localization[Overview.LoginUsersTooltip]}">
                                                                                        <TextBlock Text="{Binding LoginUserCountText}"
                                                                                                   FontSize="22"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="#F3F4F6"
                                                                                                   HorizontalAlignment="Center" />
                                                                                        <TextBlock Classes="caption"
                                                                                                   Text="{Binding Localization[Overview.LoginUsers]}"
                                                                                                   HorizontalAlignment="Center" />
                                                                                    </StackPanel>

                                                                                    <!-- Divider -->
                                                                                    <Border Grid.Row="1" Grid.ColumnSpan="3"
                                                                                            Height="1"
                                                                                            VerticalAlignment="Center"
                                                                                            Background="#1E293B" />

                                                                                    <!-- Bottom row — actionable stats: pending / last apply / risk -->
                                                                                    <StackPanel Grid.Row="2" Grid.Column="0"
                                                                                                HorizontalAlignment="Center"
                                                                                                ToolTip.Tip="{Binding Localization[Overview.PendingTooltip]}">
                                                                                        <TextBlock Text="{Binding PendingCountText}"
                                                                                                   FontSize="20"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="#F59E0B"
                                                                                                   HorizontalAlignment="Center" />
                                                                                        <TextBlock Classes="caption"
                                                                                                   Text="{Binding Localization[Overview.Pending]}"
                                                                                                   HorizontalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Row="2" Grid.Column="1"
                                                                                                HorizontalAlignment="Center"
                                                                                                ToolTip.Tip="{Binding Localization[Overview.LastApplyTooltip]}">
                                                                                        <TextBlock Text="{Binding LastApplyText}"
                                                                                                   FontSize="14"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Foreground="#94A3B8"
                                                                                                   HorizontalAlignment="Center"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Margin="0,3,0,0" />
                                                                                        <TextBlock Classes="caption"
                                                                                                   Text="{Binding Localization[Overview.LastApply]}"
                                                                                                   HorizontalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Row="2" Grid.Column="2"
                                                                                                HorizontalAlignment="Center"
                                                                                                ToolTip.Tip="{Binding Localization[Overview.RiskTooltip]}">
                                                                                        <TextBlock Text="{Binding RiskText}"
                                                                                                   FontSize="20"
                                                                                                   FontWeight="SemiBold"
                                                                                                   Classes.risk-ok="{Binding IsRiskOk}"
                                                                                                   Classes.risk-high="{Binding IsRiskHigh}"
                                                                                                   Foreground="#94A3B8"
                                                                                                   HorizontalAlignment="Center" />
                                                                                        <TextBlock Classes="caption"
                                                                                                   Text="{Binding Localization[Overview.Risk]}"
                                                                                                   HorizontalAlignment="Center" />
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <!-- AUDIT LOG — last 5 entries grouped by date. Empty state until first Apply runs. -->
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Classes="eyebrow"
                                                                                   Text="{Binding Localization[Overview.RecentSection]}" />
                                                                        <TextBlock Classes="h2"
                                                                                   Text="{Binding Localization[Overview.RecentHeading]}" />

                                                                        <!-- Empty state -->
                                                                        <Border Classes="card" Padding="20,28" Margin="0,8,0,0"
                                                                                IsVisible="{Binding RecentChanges.IsEmpty, FallbackValue=True}">
                                                                            <TextBlock Classes="subtle"
                                                                                       HorizontalAlignment="Center"
                                                                                       Text="{Binding Localization[Overview.AuditEmpty]}" />
                                                                        </Border>

                                                                        <!-- Grouped entries (compact: only headline, time, outcome — no expand here) -->
                                                                        <ItemsControl ItemsSource="{Binding RecentChanges.Groups}"
                                                                                      Margin="0,8,0,32"
                                                                                      IsVisible="{Binding RecentChanges.IsContentVisible, FallbackValue=False}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate DataType="vm:AuditDayGroup">
                                                                                    <StackPanel Margin="0,0,0,10" Spacing="4">
                                                                                        <TextBlock Classes="eyebrow" Text="{Binding Header}" />
                                                                                        <ItemsControl ItemsSource="{Binding Entries}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate DataType="vm:AuditEntryViewModel">
                                                                                                    <Border Classes="card" Padding="14,8" Margin="0,2,0,0">
                                                                                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                                                                            <TextBlock Grid.Column="0"
                                                                                                                       Text="{Binding OutcomeGlyph}"
                                                                                                                       Classes.audit-success="{Binding IsSuccess}"
                                                                                                                       Classes.audit-failure="{Binding IsFailure}"
                                                                                                                       FontWeight="Bold"
                                                                                                                       Margin="0,0,10,0"
                                                                                                                       VerticalAlignment="Center" />
                                                                                                            <StackPanel Grid.Column="1" Spacing="2">
                                                                                                                <TextBlock Text="{Binding Headline}" Foreground="#F3F4F6" />
                                                                                                                <TextBlock Classes="caption" Text="{Binding Subline}" />
                                                                                                            </StackPanel>
                                                                                                            <TextBlock Grid.Column="2" Classes="caption" Text="{Binding TimeText}" VerticalAlignment="Center" />
                                                                                                        </Grid>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </ScrollViewer>
                                                        </TabItem>

                                                        <!-- ============ Schemas tab ============ -->
                                                        <TabItem>
                                                            <TabItem.Header>
                                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Localization[Schemas.Title]}"
                                                                               VerticalAlignment="Center" />
                                                                    <Border Classes="badge">
                                                                        <TextBlock Text="{Binding Schemas.Count}" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </TabItem.Header>

                                                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                                          VerticalScrollBarVisibility="Auto"
                                                                          Padding="0,16,12,0">
                                                                <StackPanel Spacing="12">
                                                                    <Border Classes="card"
                                                                            Padding="20,28"
                                                                            IsVisible="{Binding IsSchemasEmpty}">
                                                                        <TextBlock Classes="subtle"
                                                                                   HorizontalAlignment="Center"
                                                                                   Text="{Binding Localization[Schemas.Empty]}" />
                                                                    </Border>
                                                                    <ItemsControl ItemsSource="{Binding Schemas}"
                                                                                  IsVisible="{Binding HasSchemas}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate DataType="vm:SchemaItemViewModel">
                                                                                <Border Classes="card" Padding="18,14" Margin="0,0,0,10">
                                                                                    <Grid ColumnDefinitions="Auto,*">
                                                                                        <Border Grid.Column="0"
                                                                                                Width="32" Height="32"
                                                                                                CornerRadius="6"
                                                                                                Background="#1E293B"
                                                                                                BorderBrush="#334155"
                                                                                                BorderThickness="1"
                                                                                                Margin="0,0,12,0">
                                                                                            <TextBlock Text="&#xE7C3;"
                                                                                                       FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                                                                       FontSize="14"
                                                                                                       Foreground="#94A3B8"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Classes="h3"
                                                                                                   VerticalAlignment="Center"
                                                                                                   Text="{Binding Name}" />
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </ScrollViewer>
                                                        </TabItem>

                                                        <!-- ============ Permissions tab ============ -->
                                                        <TabItem Header="{Binding Localization[DatabaseTabs.Permissions]}">
                                                            <ContentControl Content="{Binding PermissionsMatrix}"
                                                                            Margin="0,16,0,0">
                                                                <ContentControl.ContentTemplate>
                                                                    <DataTemplate DataType="vm:PermissionsMatrixViewModel">
                                                                        <!-- Outer Grid: matrix area on top + sticky bar pinned to the bottom.
                                                                             No outer ScrollViewer — the matrix card has its own internal scroll for
                                                                             schemas, the sticky bar is always visible. -->
                                                                        <Grid RowDefinitions="*,Auto">
                                                                        <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,*,Auto">

                                                                            <!-- Target user dropdown -->
                                                                            <StackPanel Grid.Row="0" Spacing="6">
                                                                                <TextBlock Classes="eyebrow"
                                                                                           Text="{Binding Localization[Permissions.TargetUser]}" />
                                                                                <ComboBox ItemsSource="{Binding TargetRoles}"
                                                                                          SelectedItem="{Binding SelectedRole}"
                                                                                          HorizontalAlignment="Left"
                                                                                          MinWidth="320"
                                                                                          MaxWidth="480">
                                                                                    <ComboBox.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                                                <Border Classes="pill accent" VerticalAlignment="Center">
                                                                                                    <TextBlock Text="login" />
                                                                                                </Border>
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </ComboBox.ItemTemplate>
                                                                                </ComboBox>
                                                                            </StackPanel>

                                                                            <!-- Loading / error / no-roles state -->
                                                                            <Border Grid.Row="1"
                                                                                    Classes="card"
                                                                                    Padding="20,28"
                                                                                    Margin="0,16,0,0"
                                                                                    IsVisible="{Binding IsLoading}">
                                                                                <TextBlock Classes="subtle"
                                                                                           HorizontalAlignment="Center"
                                                                                           Text="{Binding Localization[Common.Loading]}" />
                                                                            </Border>

                                                                            <Border Grid.Row="1"
                                                                                    Padding="14,12"
                                                                                    Margin="0,16,0,0"
                                                                                    CornerRadius="8"
                                                                                    Background="#1AE53935"
                                                                                    BorderBrush="#88E53935"
                                                                                    BorderThickness="1"
                                                                                    IsVisible="{Binding HasError}">
                                                                                <TextBlock Text="{Binding ErrorMessage}"
                                                                                           Foreground="#FFE53935"
                                                                                           TextWrapping="Wrap" />
                                                                            </Border>

                                                                            <!-- Superuser warning — Postgres bypasses every check for superusers, so the
                                                                                 matrix is effectively decorative for them. Show this front and centre. -->
                                                                            <Border Grid.Row="1"
                                                                                    Padding="14,10"
                                                                                    Margin="0,16,0,0"
                                                                                    CornerRadius="8"
                                                                                    Background="#1AF59E0B"
                                                                                    BorderBrush="#88F59E0B"
                                                                                    BorderThickness="1"
                                                                                    IsVisible="{Binding IsSelectedRoleSuperuser}">
                                                                                <StackPanel Spacing="2">
                                                                                    <TextBlock FontWeight="SemiBold"
                                                                                               Foreground="#F59E0B"
                                                                                               Text="{Binding Localization[Permissions.SuperuserBannerTitle]}" />
                                                                                    <TextBlock Foreground="#FCD34D"
                                                                                               TextWrapping="Wrap"
                                                                                               Text="{Binding Localization[Permissions.SuperuserBannerBody]}" />
                                                                                </StackPanel>
                                                                            </Border>

                                                                            <!-- Legend (above the matrix). -->
                                                                            <StackPanel Grid.Row="2"
                                                                                        Orientation="Horizontal"
                                                                                        Spacing="20"
                                                                                        Margin="4,16,0,8">
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <TextBlock Text="✓" Foreground="#10B981" FontWeight="Bold" FontSize="14" />
                                                                                    <TextBlock Classes="caption" Text="{Binding Localization[Permissions.LegendGranted]}" />
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <TextBlock Text="–" Foreground="#64748B" FontWeight="Bold" FontSize="14" />
                                                                                    <TextBlock Classes="caption" Text="{Binding Localization[Permissions.LegendNotGranted]}" />
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <TextBlock Text="+" Foreground="#3B82F6" FontWeight="Bold" FontSize="14" />
                                                                                    <TextBlock Classes="caption" Text="{Binding Localization[Permissions.LegendPendingGrant]}" />
                                                                                </StackPanel>
                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                    <TextBlock Text="✕" Foreground="#EF4444" FontWeight="Bold" FontSize="14" />
                                                                                    <TextBlock Classes="caption" Text="{Binding Localization[Permissions.LegendPendingRevoke]}" />
                                                                                </StackPanel>
                                                                            </StackPanel>

                                                                            <!-- Matrix — uses the rest of the available space; inner ScrollViewer
                                                                                 handles many schemas. -->
                                                                            <Border Grid.Row="3"
                                                                                    Classes="card"
                                                                                    Padding="0"
                                                                                    IsVisible="{Binding IsContentVisible}">
                                                                                <Grid RowDefinitions="Auto,*">
                                                                                    <!-- Header row -->
                                                                                    <Grid Grid.Row="0"
                                                                                          Background="#0F172A"
                                                                                          ColumnDefinitions="*,80,80,80,80,80,80,60"
                                                                                          Margin="12,12,12,8">
                                                                                        <TextBlock Grid.Column="0" Classes="matrix-header"
                                                                                                   Text="{Binding Localization[Permissions.ColumnSchema]}"
                                                                                                   HorizontalAlignment="Left" />
                                                                                        <TextBlock Grid.Column="1" Classes="matrix-header" Text="{Binding Localization[Permissions.ColumnUsage]}" />
                                                                                        <TextBlock Grid.Column="2" Classes="matrix-header" Text="{Binding Localization[Permissions.ColumnCreate]}" />
                                                                                        <TextBlock Grid.Column="3" Classes="matrix-header" Text="{Binding Localization[Permissions.ColumnSelect]}" />
                                                                                        <TextBlock Grid.Column="4" Classes="matrix-header" Text="{Binding Localization[Permissions.ColumnInsert]}" />
                                                                                        <TextBlock Grid.Column="5" Classes="matrix-header" Text="{Binding Localization[Permissions.ColumnUpdate]}" />
                                                                                        <TextBlock Grid.Column="6" Classes="matrix-header" Text="{Binding Localization[Permissions.ColumnDelete]}" />
                                                                                        <TextBlock Grid.Column="7" Classes="matrix-header" Text="{Binding Localization[Permissions.ColumnAll]}" />
                                                                                    </Grid>

                                                                                    <!-- Schema rows -->
                                                                                    <ScrollViewer Grid.Row="1"
                                                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                                                  VerticalScrollBarVisibility="Auto">
                                                                                        <ItemsControl ItemsSource="{Binding Rows}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate DataType="vm:SchemaPermissionRowViewModel">
                                                                                                    <Border Classes="matrix-row">
                                                                                                        <Grid ColumnDefinitions="*,80,80,80,80,80,80,60" VerticalAlignment="Center">
                                                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                                                <TextBlock Text="&#xE7C3;"
                                                                                                                           FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                                                                                                           FontSize="14"
                                                                                                                           Foreground="#94A3B8"
                                                                                                                           VerticalAlignment="Center" />
                                                                                                                <TextBlock Classes="h3" Text="{Binding SchemaName}" VerticalAlignment="Center" />
                                                                                                                <Border Classes="pill warn" IsVisible="{Binding HasPending}" VerticalAlignment="Center">
                                                                                                                    <TextBlock Text="{Binding PendingCount, StringFormat='{}{0} pending'}" />
                                                                                                                </Border>
                                                                                                            </StackPanel>

                                                                                                            <Border Grid.Column="1" Classes="matrix-cell"
                                                                                                                    DataContext="{Binding Usage}"
                                                                                                                    Classes.granted="{Binding IsGranted}"
                                                                                                                    Classes.pending-grant="{Binding IsPendingGrant}"
                                                                                                                    Classes.pending-revoke="{Binding IsPendingRevoke}"
                                                                                                                    Tapped="OnMatrixCellTapped">
                                                                                                                <TextBlock Text="{Binding Glyph}" />
                                                                                                            </Border>
                                                                                                            <Border Grid.Column="2" Classes="matrix-cell"
                                                                                                                    DataContext="{Binding Create}"
                                                                                                                    Classes.granted="{Binding IsGranted}"
                                                                                                                    Classes.pending-grant="{Binding IsPendingGrant}"
                                                                                                                    Classes.pending-revoke="{Binding IsPendingRevoke}"
                                                                                                                    Tapped="OnMatrixCellTapped">
                                                                                                                <TextBlock Text="{Binding Glyph}" />
                                                                                                            </Border>
                                                                                                            <Border Grid.Column="3" Classes="matrix-cell"
                                                                                                                    DataContext="{Binding Select}"
                                                                                                                    Classes.granted="{Binding IsGranted}"
                                                                                                                    Classes.pending-grant="{Binding IsPendingGrant}"
                                                                                                                    Classes.pending-revoke="{Binding IsPendingRevoke}"
                                                                                                                    Tapped="OnMatrixCellTapped">
                                                                                                                <TextBlock Text="{Binding Glyph}" />
                                                                                                            </Border>
                                                                                                            <Border Grid.Column="4" Classes="matrix-cell"
                                                                                                                    DataContext="{Binding Insert}"
                                                                                                                    Classes.granted="{Binding IsGranted}"
                                                                                                                    Classes.pending-grant="{Binding IsPendingGrant}"
                                                                                                                    Classes.pending-revoke="{Binding IsPendingRevoke}"
                                                                                                                    Tapped="OnMatrixCellTapped">
                                                                                                                <TextBlock Text="{Binding Glyph}" />
                                                                                                            </Border>
                                                                                                            <Border Grid.Column="5" Classes="matrix-cell"
                                                                                                                    DataContext="{Binding Update}"
                                                                                                                    Classes.granted="{Binding IsGranted}"
                                                                                                                    Classes.pending-grant="{Binding IsPendingGrant}"
                                                                                                                    Classes.pending-revoke="{Binding IsPendingRevoke}"
                                                                                                                    Tapped="OnMatrixCellTapped">
                                                                                                                <TextBlock Text="{Binding Glyph}" />
                                                                                                            </Border>
                                                                                                            <Border Grid.Column="6" Classes="matrix-cell"
                                                                                                                    DataContext="{Binding Delete}"
                                                                                                                    Classes.granted="{Binding IsGranted}"
                                                                                                                    Classes.pending-grant="{Binding IsPendingGrant}"
                                                                                                                    Classes.pending-revoke="{Binding IsPendingRevoke}"
                                                                                                                    Tapped="OnMatrixCellTapped">
                                                                                                                <TextBlock Text="{Binding Glyph}" />
                                                                                                            </Border>
                                                                                                            <!-- ALL toggle — DataContext stays the row VM, handler calls row.ToggleAll(). -->
                                                                                                            <Border Grid.Column="7" Classes="matrix-cell"
                                                                                                                    ToolTip.Tip="Toggle ALL"
                                                                                                                    Tapped="OnMatrixToggleAllTapped">
                                                                                                                <TextBlock Text="∗" />
                                                                                                            </Border>
                                                                                                        </Grid>
                                                                                                    </Border>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </ScrollViewer>
                                                                                </Grid>
                                                                            </Border>

                                                                            <!-- Status / applied confirmation -->
                                                                            <TextBlock Grid.Row="4"
                                                                                       Classes="caption"
                                                                                       Foreground="#10B981"
                                                                                       Margin="4,8,0,0"
                                                                                       Text="{Binding StatusMessage}"
                                                                                       IsVisible="{Binding HasStatus}" />

                                                                        </Grid>

                                                                        <!-- Sticky bottom bar — pinned to the bottom of the tab, OUTSIDE the
                                                                             scroll area, so it's always visible when there's anything pending. -->
                                                                        <Border Grid.Row="1"
                                                                                Margin="0,12,0,0"
                                                                                Padding="20,14"
                                                                                CornerRadius="10"
                                                                                Background="#1A1F2E"
                                                                                BorderBrush="#F59E0B"
                                                                                BorderThickness="1"
                                                                                IsVisible="{Binding HasPending}">
                                                                                <Grid RowDefinitions="Auto,Auto,Auto">

                                                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                                                        <!-- Left: total badge + summary line -->
                                                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                                                                            <Border Width="32" Height="32"
                                                                                                    CornerRadius="999"
                                                                                                    Background="#F59E0B"
                                                                                                    VerticalAlignment="Center">
                                                                                                <TextBlock Text="{Binding PendingCount}"
                                                                                                           Foreground="#0F172A"
                                                                                                           FontWeight="Bold"
                                                                                                           HorizontalAlignment="Center"
                                                                                                           VerticalAlignment="Center" />
                                                                                            </Border>
                                                                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                                                                <TextBlock FontWeight="SemiBold"
                                                                                                           Foreground="#F3F4F6"
                                                                                                           Text="{Binding Localization[Permissions.PendingHeading]}" />
                                                                                                <TextBlock Classes="caption"
                                                                                                           Text="{Binding SelectionSummary}" />
                                                                                            </StackPanel>
                                                                                        </StackPanel>

                                                                                        <!-- Right: Discard all / Preview selected / Apply selected -->
                                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                            <Button Padding="14,8"
                                                                                                    Content="{Binding Localization[Permissions.Discard]}"
                                                                                                    Command="{Binding DiscardCommand}" />
                                                                                            <Button Padding="14,8"
                                                                                                    Command="{Binding PreviewSqlCommand}"
                                                                                                    Content="{Binding Localization[Permissions.PreviewSql]}" />
                                                                                            <Button Classes="accent"
                                                                                                    Padding="14,8"
                                                                                                    Command="{Binding ApplySelectedCommand}">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                    <TextBlock Text="✓" FontWeight="Bold" />
                                                                                                    <TextBlock Text="{Binding Localization[Permissions.Apply]}" />
                                                                                                    <TextBlock Text="{Binding SelectedChangeCount, StringFormat='({0})'}" />
                                                                                                </StackPanel>
                                                                                            </Button>
                                                                                        </StackPanel>
                                                                                    </Grid>

                                                                                    <!-- Per-role breakdown — full card per role with its own Discard / Apply.
                                                                                         User can ship one user's changes at a time without committing the rest.
                                                                                         Capped + scrollable so the sticky bar can never push the matrix off screen. -->
                                                                                    <ScrollViewer Grid.Row="1"
                                                                                                  Margin="0,12,0,0"
                                                                                                  MaxHeight="180"
                                                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                                                  VerticalScrollBarVisibility="Auto">
                                                                                    <ItemsControl ItemsSource="{Binding PendingGroups}">
                                                                                        <ItemsControl.ItemsPanel>
                                                                                            <ItemsPanelTemplate>
                                                                                                <StackPanel Orientation="Vertical" Spacing="6" />
                                                                                            </ItemsPanelTemplate>
                                                                                        </ItemsControl.ItemsPanel>
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate DataType="vm:PendingGroup">
                                                                                                <Border Padding="14,10"
                                                                                                        CornerRadius="8"
                                                                                                        Background="#0F172A"
                                                                                                        BorderBrush="#334155"
                                                                                                        BorderThickness="1">
                                                                                                    <StackPanel Spacing="6">
                                                                                                        <!-- Role header: name + selected/total + Discard -->
                                                                                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                                                <TextBlock FontWeight="SemiBold"
                                                                                                                           Foreground="#F3F4F6"
                                                                                                                           Text="{Binding RoleName}" />
                                                                                                                <TextBlock Classes="caption"
                                                                                                                           Foreground="#64748B"
                                                                                                                           Text="{Binding TotalCount, StringFormat='{}{0} change(s)'}" />
                                                                                                            </StackPanel>
                                                                                                            <Button Grid.Column="1"
                                                                                                                    Padding="10,4"
                                                                                                                    FontSize="12"
                                                                                                                    Content="{Binding $parent[ItemsControl].((vm:PermissionsMatrixViewModel)DataContext).Localization[Permissions.Discard]}"
                                                                                                                    Command="{Binding $parent[ItemsControl].((vm:PermissionsMatrixViewModel)DataContext).DiscardRoleCommand}"
                                                                                                                    CommandParameter="{Binding RoleName}" />
                                                                                                        </Grid>
                                                                                                        <!-- Individual changes — checkbox controls whether Apply selected includes it -->
                                                                                                        <ItemsControl ItemsSource="{Binding Changes}" Margin="6,0,0,0">
                                                                                                            <ItemsControl.ItemTemplate>
                                                                                                                <DataTemplate DataType="vm:PendingChangeViewModel">
                                                                                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                                                              Margin="0,1,0,1"
                                                                                                                              Padding="6,0,0,0">
                                                                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                                                            <TextBlock Text="{Binding Glyph}"
                                                                                                                                       FontWeight="Bold"
                                                                                                                                       Classes.chg-grant="{Binding IsGrant}"
                                                                                                                                       Classes.chg-revoke="{Binding IsRevoke}" />
                                                                                                                            <TextBlock Foreground="#D1D5DB" Text="{Binding Label}" />
                                                                                                                        </StackPanel>
                                                                                                                    </CheckBox>
                                                                                                                </DataTemplate>
                                                                                                            </ItemsControl.ItemTemplate>
                                                                                                        </ItemsControl>
                                                                                                    </StackPanel>
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                    </ScrollViewer>

                                                                                    <!-- Hint -->
                                                                                    <TextBlock Grid.Row="2"
                                                                                               Classes="caption"
                                                                                               Margin="2,8,0,0"
                                                                                               Text="{Binding Localization[Permissions.PerRoleHint]}"
                                                                                               IsVisible="{Binding HasMultiplePendingRoles}" />
                                                                                </Grid>
                                                                        </Border>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ContentControl.ContentTemplate>
                                                            </ContentControl>
                                                        </TabItem>

                                                        <!-- ============ SQL log tab ============ -->
                                                        <TabItem Header="{Binding Localization[DatabaseTabs.SqlLog]}">
                                                            <ContentControl Content="{Binding SqlLog}" Margin="0,16,0,0">
                                                                <ContentControl.ContentTemplate>
                                                                    <DataTemplate DataType="vm:AuditLogViewModel">
                                                                        <Grid RowDefinitions="Auto,*">

                                                                            <!-- Empty state when no entries -->
                                                                            <Border Grid.Row="0"
                                                                                    Classes="card"
                                                                                    Padding="20,28"
                                                                                    IsVisible="{Binding IsEmpty}">
                                                                                <TextBlock Classes="subtle"
                                                                                           HorizontalAlignment="Center"
                                                                                           Text="{Binding $parent[ContentControl].((vm:DatabaseDetailsViewModel)DataContext).Localization[Overview.AuditEmpty]}" />
                                                                            </Border>

                                                                            <!-- Loading -->
                                                                            <Border Grid.Row="0"
                                                                                    Classes="card"
                                                                                    Padding="20,28"
                                                                                    IsVisible="{Binding IsLoading}">
                                                                                <TextBlock Classes="subtle"
                                                                                           HorizontalAlignment="Center"
                                                                                           Text="{Binding $parent[ContentControl].((vm:DatabaseDetailsViewModel)DataContext).Localization[Common.Loading]}" />
                                                                            </Border>

                                                                            <!-- Day-grouped entries -->
                                                                            <ScrollViewer Grid.Row="1"
                                                                                          IsVisible="{Binding IsContentVisible}"
                                                                                          HorizontalScrollBarVisibility="Disabled"
                                                                                          VerticalScrollBarVisibility="Auto">
                                                                                <ItemsControl ItemsSource="{Binding Groups}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="vm:AuditDayGroup">
                                                                                            <StackPanel Margin="0,0,0,12" Spacing="6">
                                                                                                <TextBlock Classes="eyebrow" Text="{Binding Header}" />
                                                                                                <ItemsControl ItemsSource="{Binding Entries}">
                                                                                                    <ItemsControl.ItemTemplate>
                                                                                                        <DataTemplate DataType="vm:AuditEntryViewModel">
                                                                                                            <Border Classes="card" Padding="14,10" Margin="0,4,0,0">
                                                                                                                <StackPanel Spacing="6">
                                                                                                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                                                                                        <TextBlock Grid.Column="0"
                                                                                                                                   Text="{Binding OutcomeGlyph}"
                                                                                                                                   Classes.audit-success="{Binding IsSuccess}"
                                                                                                                                   Classes.audit-failure="{Binding IsFailure}"
                                                                                                                                   FontWeight="Bold"
                                                                                                                                   FontSize="14"
                                                                                                                                   Margin="0,0,10,0"
                                                                                                                                   VerticalAlignment="Center" />
                                                                                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                                                                                            <TextBlock Text="{Binding Headline}" Foreground="#F3F4F6" />
                                                                                                                            <TextBlock Classes="caption" Text="{Binding Subline}" />
                                                                                                                        </StackPanel>
                                                                                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                                                                            <TextBlock Classes="caption" Text="{Binding TimeText}" />
                                                                                                                            <Button Classes="icon"
                                                                                                                                    Padding="6,2"
                                                                                                                                    Content="{Binding ChevronGlyph}"
                                                                                                                                    Command="{Binding ToggleExpandCommand}" />
                                                                                                                        </StackPanel>
                                                                                                                    </Grid>
                                                                                                                    <ItemsControl ItemsSource="{Binding Entry.Statements}"
                                                                                                                                  IsVisible="{Binding IsExpanded}"
                                                                                                                                  Margin="24,4,0,0">
                                                                                                                        <ItemsControl.ItemTemplate>
                                                                                                                            <DataTemplate>
                                                                                                                                <TextBlock Text="{Binding}"
                                                                                                                                           FontFamily="Consolas,Cascadia Mono,monospace"
                                                                                                                                           FontSize="12"
                                                                                                                                           Foreground="#94A3B8"
                                                                                                                                           TextWrapping="Wrap"
                                                                                                                                           Margin="0,2,0,2" />
                                                                                                                            </DataTemplate>
                                                                                                                        </ItemsControl.ItemTemplate>
                                                                                                                    </ItemsControl>
                                                                                                                </StackPanel>
                                                                                                            </Border>
                                                                                                        </DataTemplate>
                                                                                                    </ItemsControl.ItemTemplate>
                                                                                                </ItemsControl>
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ContentControl.ContentTemplate>
                                                            </ContentControl>
                                                        </TabItem>
                                                    </TabControl>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </Grid>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>

                <!-- View 3: application settings -->
                <Grid Margin="36,16,36,16"
                      RowDefinitions="Auto,*"
                      IsVisible="{Binding IsViewingSettings}">

                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,18">
                        <StackPanel DockPanel.Dock="Left" Spacing="3">
                            <TextBlock Classes="eyebrow" Text="{Binding Localization[Settings.Eyebrow]}" />
                            <TextBlock Classes="h1" Text="{Binding Localization[Settings.Title]}" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                VerticalAlignment="Center"
                                Content="{Binding Localization[Settings.Done]}"
                                Command="{Binding CloseSettingsCommand}" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" MaxWidth="520" HorizontalAlignment="Left">
                            <Border Classes="card" Padding="20,20">
                                <StackPanel Classes="form-section">
                                    <TextBlock Classes="label" Text="{Binding Localization[Settings.LanguageLabel]}" />
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage}"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="globalization:CultureInfo">
                                                <TextBlock Text="{Binding NativeName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Classes="caption"
                                               TextWrapping="Wrap"
                                               Text="{Binding Localization[Settings.LanguageHint]}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
