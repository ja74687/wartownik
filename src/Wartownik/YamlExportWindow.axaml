<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:yml="using:Wartownik.Yaml"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="540"
        x:Class="Wartownik.YamlExportWindow"
        x:DataType="yml:YamlExportRequest"
        Title="Export YAML"
        Width="720" Height="540"
        MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#0F172A"
        TransparencyLevelHint="None"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Grid RowDefinitions="32,*">

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="#0F172A" ColumnDefinitions="*,Auto">
            <Border Grid.Column="0"
                    Background="#0F172A"
                    PointerPressed="OnTitleBarPointerPressed" />
            <Button Grid.Column="1"
                    Classes="caption close"
                    Content="&#xE8BB;"
                    FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                    ToolTip.Tip="Close"
                    Click="OnCloseClick" />
        </Grid>

        <Grid Grid.Row="1" Margin="28,16,28,20" RowDefinitions="Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0" Classes="eyebrow" Text="EXPORT" />
            <TextBlock Grid.Row="0" Classes="h2" Text="pgbedrock-compatible YAML" Margin="0,16,0,0" />
            <TextBlock Grid.Row="1"
                       Classes="caption"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="Snapshot of schema-level privileges for every login role on this database. Save to a file or paste into your pgbedrock workflow." />

            <!-- Read-only YAML preview -->
            <Border Grid.Row="2"
                    Classes="card"
                    Padding="0"
                    Margin="0,16,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding Yaml}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             FontFamily="Consolas,Cascadia Mono,monospace"
                             FontSize="12"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="14,12" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8"
                        Margin="0,16,0,0">
                <Button Padding="20,8"
                        MinWidth="160"
                        Content="Copy to clipboard"
                        Click="OnCopyClick" />
                <Button Padding="20,8"
                        MinWidth="120"
                        Classes="accent"
                        Content="Save to file…"
                        Click="OnSaveClick" />
                <Button Padding="20,8"
                        MinWidth="100"
                        Content="Close"
                        Click="OnCloseButtonClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
